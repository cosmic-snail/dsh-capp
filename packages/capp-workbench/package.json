  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@types/react": "18.3.31",
    "capp-common": "workspace:*"
  }
}
