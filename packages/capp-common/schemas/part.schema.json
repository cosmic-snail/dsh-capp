{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capp.part/v0",
  "type": "object",
  "required": ["schema", "source", "units", "features"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "capp.part/v0" },
    "source": {
      "type": "object",
      "required": ["file", "sha256"],
      "additionalProperties": true,
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "units": { "type": "string" },
    "bbox": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min": { "type": "array", "items": { "type": "number" } },
        "max": { "type": "array", "items": { "type": "number" } }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "params": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "material": {},
    "raw": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
